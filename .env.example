# Copy to .env (adjust values as needed) and export to environment when running.

# Comma-separated frontend origins allowed for CORS
# Example for local Vite dev server:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Basic per-minute rate limit for hot endpoints
RATE_LIMIT_PER_MINUTE=60

# Default request timeout (seconds) for outbound requests
REQUEST_TIMEOUT_SECONDS=15

# Optional: restrict proxy to these hostnames (comma-separated).
# If empty, built-in fixed proxy targets apply.
PROXY_HOST_ALLOWLIST=

